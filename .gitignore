# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
env/
.venv/

# Environment variables / secrets
.env
.env.*
!.env.example

# Django migrations (keep __init__.py so apps stay importable)
**/migrations/*
!**/migrations/__init__.py

# Local database
*.sqlite3
*.sqlite3-journal
db.sqlite3

# Media files (user uploads)
media/

# Collected static files (generated by collectstatic)
staticfiles/

# Logs
*.log

# IDE / editor
.vscode/
.idea/
*.swp

# OS files
Thumbs.db
.DS_Store

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/
